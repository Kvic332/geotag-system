# Copy to .env.local and adjust.
#   cp .env.local.example .env.local
#
# .env.local is git-ignored. Never commit a real JWT.

# Backend base URL (SAM local / backend/local_server.py)
VITE_API_URL=http://localhost:3000

# Serve canned, contract-shaped data instead of calling the backend.
# Lets you exercise the map / list / editor / event log with no backend running.
# Set to "true" to enable. Anything else (or unset) = talk to the real API.
VITE_USE_FIXTURES=false

# Optional: pre-seed the dev JWT so you don't have to paste it into the UI on
# every fresh browser profile. LEAVE THIS EMPTY IN ANY COMMITTED FILE.
# Mint one with:  python backend/scripts/mint_dev_token.py
# If unset, paste the token into the "Dev token" box in the dashboard header —
# it is stored in localStorage only.
VITE_DEV_JWT=

# NOTE: no Mapbox token. This dashboard uses Leaflet + OpenStreetMap tiles,
# so it needs no map credentials at all.
