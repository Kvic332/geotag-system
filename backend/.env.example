# Copy to backend/.env for local dev (python-dotenv / your shell can load it).
# Never commit backend/.env — it is gitignored.

# Data
DATABASE_URL=postgresql://postgres:dev@localhost:5432/geotag
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS
AWS_REGION=eu-west-1
AWS_LOCATION_COLLECTION=geotag-geofences

# Auth (SPEC-DECISIONS D6)
# Local dev only — an obvious placeholder, not a real secret. Generate your
# own with e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`
# and mint tokens against it with backend/scripts/mint_dev_token.py.
DEV_JWT_SECRET=local-dev-secret-change-me-please-32chars
COGNITO_USER_POOL_ID=eu-west-1_xxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# SNS — unset or ENVIRONMENT=local both make event notifications a no-op log
# line instead of a real publish (see backend/event_processor/notifications.py)
SNS_TOPIC_ARN=

# Env flag
ENVIRONMENT=local
